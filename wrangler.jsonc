{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shipping-binaries",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "shippingbinaries.com",
      "custom_domain": true
    },
    {
      "pattern": "www.shippingbinaries.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public"
  },
  // POSTHOG_API_KEY is a secret (`wrangler secret put`); the host is just the
  // ingestion endpoint, so it lives with the rest of the deploy config.
  "vars": {
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shipping-binaries",
      "database_id": "92383e1c-8c42-47db-a2df-4df5f352a12d"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@shippingbinaries.com"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
